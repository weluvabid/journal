---
import JournalFooter from '@components/site/JournalFooter.svelte';
import JournalHeader from '@components/site/JournalHeader.svelte';
import JournalToaster from '@components/site/JournalToaster.svelte';
import KeyboardNavigationPrompt from '@components/site/KeyboardNavigationPrompt.svelte';
import { ClientRouter } from 'astro:transitions';
import { createThemeScript } from '@weluvabid/iris/theme';
import '@styles/global.css';

import faviconSvg from '../../brand/me/favicon/favicon.svg?url';
import faviconIco from '../../brand/me/favicon/favicon.ico?url';
import favicon16 from '../../brand/me/exports/favicon/favicon-16.png?url';
import favicon32 from '../../brand/me/exports/favicon/favicon-32.png?url';
import favicon192 from '../../brand/me/exports/favicon/favicon-192.png?url';
import appleTouchIcon from '../../brand/me/exports/favicon/favicon-180.png?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Journal — How I think. What I build.',
  description = 'Thoughts, experiments, build logs and technical writing about how software gets made.',
} = Astro.props;

const themeBootstrap = createThemeScript();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf8" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/x-icon" href={faviconIco} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
    <link rel="icon" type="image/png" sizes="192x192" href={favicon192} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
    <meta property="og:site_name" content="Journal" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={themeBootstrap} />
    <ClientRouter />
    <script is:inline>
      if (!window.__journalRouterLifecycleInstalled) {
        window.__journalRouterLifecycleInstalled = true;

        document.addEventListener(
          'click',
          (event) => {
            if (!(event instanceof MouseEvent) || event.defaultPrevented) return;
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            const target = event.target;
            if (!(target instanceof Element)) return;
            const link = target.closest('a[href]');
            if (!(link instanceof HTMLAnchorElement)) return;
            if (
              link.hasAttribute('download') ||
              link.hasAttribute('data-astro-reload') ||
              (link.target && link.target !== '_self')
            ) {
              return;
            }
            if (link.relList.contains('external')) return;

            const destination = new URL(link.href, window.location.href);
            const current = new URL(window.location.href);
            if (
              destination.origin === current.origin &&
              destination.pathname === current.pathname &&
              destination.search === current.search &&
              destination.hash === current.hash
            ) {
              event.preventDefault();
            }
          },
          true,
        );

        document.addEventListener('astro:before-swap', (event) => {
          const currentThemeIsDark = document.documentElement.classList.contains('dark');
          event.newDocument.documentElement.classList.toggle('dark', currentThemeIsDark);
        });

        document.addEventListener('astro:before-preparation', (event) => {
          const loader = document.getElementById('journal-navigation-loader');
          const originalLoader = event.loader;

          event.loader = async () => {
            const revealTimer = window.setTimeout(() => {
              if (loader) {
                loader.dataset.visible = 'true';
                loader.setAttribute('aria-hidden', 'false');
              }
            }, 200);

            try {
              await originalLoader();
            } finally {
              window.clearTimeout(revealTimer);
              if (loader) {
                delete loader.dataset.visible;
                loader.setAttribute('aria-hidden', 'true');
              }
            }
          };
        });

        document.addEventListener('astro:page-load', () => {
          const loader = document.getElementById('journal-navigation-loader');
          if (loader) {
            delete loader.dataset.visible;
            loader.setAttribute('aria-hidden', 'true');
          }
        });
      }
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-[110] -translate-y-[calc(100%+1rem)] rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-transform focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring motion-reduce:transition-none"
    >
      Skip to content
    </a>
    <div
      id="journal-navigation-loader"
      class="pointer-events-none invisible fixed left-1/2 top-3 z-[100] inline-flex -translate-x-1/2 items-center gap-2 rounded-full border border-border bg-background/95 px-3 py-2 text-xs font-medium text-muted-foreground opacity-0 shadow-sm backdrop-blur-sm transition-opacity duration-150 data-[visible=true]:visible data-[visible=true]:opacity-100 motion-reduce:transition-none"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      aria-hidden="true"
    >
      <span
        class="size-3.5 animate-spin rounded-full border-2 border-primary border-r-transparent motion-reduce:animate-none"
        aria-hidden="true"></span>
      Loading
    </div>
    <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col px-4 pb-24 sm:px-6 sm:pb-0">
      <JournalHeader client:load />
      <main id="main-content" tabindex="-1" class="min-h-0 flex-1 scroll-mt-28 py-12 sm:py-16">
        <slot />
      </main>
      <JournalFooter />
      <JournalToaster client:load />
      <KeyboardNavigationPrompt client:load />
    </div>
  </body>
</html>
