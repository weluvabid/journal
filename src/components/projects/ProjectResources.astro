---
import { Badge, Button } from '@weluvabid/iris/components';
import { ExternalLink } from '@weluvabid/iris/lucide';
import type { CollectionEntry } from 'astro:content';

type ProjectDetails = NonNullable<CollectionEntry<'journal'>['data']['projectDetails']>;
const { details, title } = Astro.props as { details: ProjectDetails; title: string };
const primaryLinks = [
  { label: 'Source repository', url: details.github },
  { label: 'Live demo', url: details.demo },
  { label: 'StackBlitz', url: details.stackblitz },
  { label: 'Mermaid diagram', url: details.mermaid },
].filter((item): item is { label: string; url: string } => Boolean(item.url));
---

<section class="mt-12 border-t border-border pt-8" aria-labelledby="project-resources-heading">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Project</p>
      <h2 id="project-resources-heading" class="mt-2 text-xl font-semibold tracking-tight">
        {title}
      </h2>
    </div>
    <Badge.Badge variant="outline" class="capitalize">{details.status}</Badge.Badge>
  </div>
  <div class="mt-5 flex flex-wrap gap-2">
    {details.stack.map((item) => <Badge.Badge variant="secondary">{item}</Badge.Badge>)}
  </div>
  {
    primaryLinks.length > 0 && (
      <ul class="mt-6 grid gap-2 sm:grid-cols-2">
        {primaryLinks.map((item) => (
          <li>
            <Button.Root
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              variant="outline"
              class="w-full justify-between"
            >
              {item.label}<ExternalLink class="size-4" aria-hidden="true" />
            </Button.Root>
          </li>
        ))}
      </ul>
    )
  }
  {
    details.resources.length > 0 && (
      <div class="mt-7">
        <h3 class="text-sm font-semibold">Repository notes and resources</h3>
        <ul class="mt-3 space-y-2">
          {details.resources.map((resource) => (
            <li class="text-sm leading-6 text-muted-foreground">
              {resource.url ? (
                <a
                  class="text-foreground underline underline-offset-4"
                  href={resource.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {resource.label}
                </a>
              ) : (
                resource.label
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
