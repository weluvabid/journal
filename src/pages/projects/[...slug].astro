---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Badge, Breadcrumb, Button } from '@weluvabid/iris/components';
import { ArrowLeft, ExternalLink } from '@weluvabid/iris/lucide';
import { entryHref, withBase } from '@lib/journal';
import TagList from '@components/cards/TagList.svelte';
import ResourceActions from '@components/resources/ResourceActions.svelte';
export async function getStaticPaths() {
  const [projects, journalEntries] = await Promise.all([
    getCollection('projects'),
    getCollection('journal', ({ data }) => !data.draft),
  ]);
  const journalIds = new Set(journalEntries.map((entry) => entry.data.id));

  for (const project of projects) {
    const references = project.data.journal;
    if (!references) continue;

    for (const id of [references.primary, ...references.related]) {
      if (!journalIds.has(id)) {
        throw new Error(
          `Project "${project.data.id}" references missing or unpublished journal entry "${id}"`,
        );
      }
    }

    if (
      new Set(references.related).size !== references.related.length ||
      references.related.includes(references.primary)
    ) {
      throw new Error(`Project "${project.data.id}" contains duplicate journal references`);
    }
  }

  return projects.map((entry) => ({ params: { slug: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Projects`} description={entry.data.summary}>
  <article class="mx-auto max-w-3xl">
    <Breadcrumb.Root class="mb-8"
      ><Breadcrumb.List
        ><Breadcrumb.Item
          ><Breadcrumb.Link href={withBase('/projects/')}>Projects</Breadcrumb.Link
          ></Breadcrumb.Item
        ><Breadcrumb.Separator /><Breadcrumb.Item
          ><Breadcrumb.Page>{entry.data.title}</Breadcrumb.Page></Breadcrumb.Item
        ></Breadcrumb.List
      ></Breadcrumb.Root
    >
    <header class="mb-10 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
        <Badge.Badge variant="outline" class="capitalize">{entry.data.status}</Badge.Badge>
      </div><div class="pointer-events-auto mt-3 block w-full min-w-0 max-w-full">
        <TagList tags={entry.data.tags} label={entry.data.title} collection="projects" />
      </div><h1 class="mt-4 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        {entry.data.title}
      </h1><p class="mt-5 text-base leading-8 text-muted-foreground">{entry.data.summary}</p>{
        (entry.data.github || entry.data.stackblitz || entry.data.mermaid || entry.data.journal?.primary) && (
          <ResourceActions
            client:load
            links={{
              git: entry.data.github,
              stackblitz: entry.data.stackblitz,
              mermaid: entry.data.mermaid,
            }}
            journalHref={
              entry.data.journal?.primary ? entryHref(entry.data.journal.primary) : undefined
            }
            title={entry.data.title}
          />
        )
      }{
        entry.data.demo && (
          <div class="mt-4">
            <Button.Root
              variant="outline"
              href={entry.data.demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Live demo <ExternalLink class="size-4" aria-hidden="true" />
            </Button.Root>
          </div>
        )
      }
    </header>
    <div class="prose-journal"><Content /></div>
    <div class="mt-10">
      <Button.Root variant="ghost" href={withBase('/projects/')}
        ><ArrowLeft class="size-4" aria-hidden="true" />Back to projects</Button.Root
      >
    </div>
  </article>
</BaseLayout>
