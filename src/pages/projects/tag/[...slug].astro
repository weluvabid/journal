---
import { getCollection } from 'astro:content';
import { withBase } from '@lib/journal';

export async function getStaticPaths() {
  const projects = await getCollection(
    'journal',
    ({ data }) => !data.draft && data.kind === 'project',
  );
  const tags = new Set(
    projects.flatMap((entry) =>
      entry.data.tags.map((tag) =>
        tag
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, ''),
      ),
    ),
  );

  return [...tags].map((slug) => ({ params: { slug } }));
}

return Astro.redirect(withBase('/projects/'), 301);
---
