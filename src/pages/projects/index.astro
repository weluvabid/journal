---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/cards/ProjectCard.svelte';
import { Breadcrumb } from '@weluvabid/iris/components';
import { entryHref } from '@lib/journal';
import { assertProjectAssociations } from '@lib/journal-projects';
import {
  assertFeaturedProjectCount,
  FEATURED_PROJECT_COUNT,
  rankProjects,
} from '@lib/project-ranking';
import { INTENTS, pluralize } from '@lib/content-text';

const allEntries = await getCollection('journal');
const entries = allEntries.filter((entry) => !entry.data.draft);
assertProjectAssociations(allEntries, entries);
const publishedProjects = entries.filter((entry) => entry.data.kind === 'project');
assertFeaturedProjectCount(publishedProjects);
const projects = rankProjects(publishedProjects);
const featuredProjects = projects.slice(0, FEATURED_PROJECT_COUNT);
const additionalProjects = projects.slice(FEATURED_PROJECT_COUNT);
---

<BaseLayout
  title="Projects — Journal"
  description="Selected software projects and engineering work."
>
  <Breadcrumb.Root class="mb-8">
    <Breadcrumb.List>
      <Breadcrumb.Item><Breadcrumb.Page>Projects</Breadcrumb.Page></Breadcrumb.Item>
    </Breadcrumb.List>
  </Breadcrumb.Root>
  <h1 class="sr-only">Projects</h1>
  <p class="mb-8 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
    {pluralize(projects.length, INTENTS.project)}
  </p>
  <section aria-labelledby="featured-projects-heading">
    <h2 id="featured-projects-heading" class="mb-5 text-lg font-semibold tracking-tight">
      Selected work
    </h2>
    <div class="grid items-stretch gap-3 sm:grid-cols-2">
      {
        featuredProjects.map((entry, index) => (
          <ProjectCard
            project={{
              id: entry.data.project!,
              title: entry.data.title,
              summary: entry.data.summary,
              status: entry.data.projectDetails!.status,
              order: index + 1,
              tags: entry.data.tags.filter((tag) => tag !== 'project'),
            }}
            href={entryHref(entry.data.id)}
            class="h-full"
          />
        ))
      }
    </div>
  </section>
  {
    additionalProjects.length > 0 && (
      <section class="mt-12" aria-labelledby="additional-projects-heading">
        <h2 id="additional-projects-heading" class="mb-5 text-lg font-semibold tracking-tight">
          More projects
        </h2>
        <div class="grid items-stretch gap-3 sm:grid-cols-2">
          {additionalProjects.map((entry, index) => (
            <ProjectCard
              project={{
                id: entry.data.project!,
                title: entry.data.title,
                summary: entry.data.summary,
                status: entry.data.projectDetails!.status,
                order: FEATURED_PROJECT_COUNT + index + 1,
                tags: entry.data.tags.filter((tag) => tag !== 'project'),
              }}
              href={entryHref(entry.data.id)}
              class="h-full"
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
