---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Button } from '@weluvabid/iris/components';
import { withBase, entryHref } from '@lib/journal';
import ProjectCard from '@components/cards/ProjectCard.svelte';
import JournalEntryCard from '@components/cards/JournalEntryCard.svelte';

const allEntries = await getCollection('journal', ({ data }) => !data.draft);
const entries = [...allEntries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestEntries = entries.slice(0, 5);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const selectedProjects = projects.slice(0, 4);
---

<BaseLayout
  title="Journal — How I think. What I build."
  description="Engineering notes, experiments, project write-ups and technical deep dives."
>
  <section class="mx-auto max-w-3xl py-10 sm:py-14">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
      An engineering journal
    </p>
    <h1 class="mt-4 text-balance text-3xl font-semibold tracking-tight sm:text-5xl">
      How I think. What I build.
    </h1>
    <p class="mt-5 max-w-2xl text-pretty text-base leading-8 text-muted-foreground sm:text-lg">
      Notes from working through engineering problems: the experiments, decisions, dead ends and
      ideas behind the software I build.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <Button.Root href={withBase('/journal/')} variant="default">Read the journal</Button.Root>
      <Button.Root href={withBase('/projects/')} variant="outline">Explore projects</Button.Root>
    </div>
  </section>

  <div data-keyboard-navigation="primary">
    <section class="mx-auto mt-4 max-w-5xl py-10 sm:py-14" aria-labelledby="projects-heading">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
            The work
          </p>
          <h2 id="projects-heading" class="mt-2 text-2xl font-semibold tracking-tight">
            Selected projects
          </h2>
        </div>
        <Button.Root variant="link" href={withBase('/projects/')}>All projects</Button.Root>
      </div>
      <div class="grid items-stretch gap-3 sm:grid-cols-2">
        {
          selectedProjects.map((project, index) => (
            <ProjectCard
              project={project.data}
              href={withBase(`/projects/${project.data.id}/`)}
              number={index + 1}
              class="h-full"
            />
          ))
        }
      </div>
    </section>

    <section class="mx-auto mt-4 max-w-5xl pb-8" aria-labelledby="featured-heading">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
            The journal
          </p>
          <h2 id="featured-heading" class="mt-2 text-2xl font-semibold tracking-tight">
            Featured writing
          </h2>
        </div>
        <Button.Root variant="link" href={withBase('/journal/')}>All entries</Button.Root>
      </div>
      <ol class="space-y-3" aria-label="Recent journal entries">
        {
          latestEntries.map((entry, index) => (
            <li>
              <JournalEntryCard
                entry={{
                  id: entry.data.id,
                  title: entry.data.title,
                  summary: entry.data.summary,
                  type: entry.data.type,
                  date: entry.data.date.toISOString(),
                  dateLabel: entry.data.date.toLocaleDateString('en', {
                    dateStyle: 'medium',
                    timeZone: 'UTC',
                  }),
                  tags: entry.data.tags,
                  href: entryHref(entry.data.id),
                }}
                index={index + selectedProjects.length}
              />
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
