---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Card, Badge, Breadcrumb } from '@weluvabid/iris/components';
import { domainById, domains } from '@data/domains';
import { assertValidQuestionGraph } from '@lib/content';
import { orderDomainQuestions, questionHref, withBase } from '@lib/atlas';

export async function getStaticPaths() {
  const entries = await getCollection('questions');
  const questions = assertValidQuestionGraph(entries);
  return domains.map((domain) => ({
    params: { domain: domain.id },
    props: { domain, questions: questions.filter((question) => question.domain === domain.id) },
  }));
}

const { domain, questions } = Astro.props;
if (!domainById.has(domain.id)) throw new Error(`Unknown domain route: ${domain.id}`);
const ordered = orderDomainQuestions(questions).map((question) => {
  return { ...question, url: questionHref(question.id) };
});
---

<BaseLayout title={`${domain.name} — Frontend Atlas`} description={domain.description}>
  <Breadcrumb.Root class="mb-8">
    <Breadcrumb.List>
      <Breadcrumb.Item
        ><Breadcrumb.Link href={withBase('/domains/')}>Domains</Breadcrumb.Link></Breadcrumb.Item
      >
      <Breadcrumb.Separator />
      <Breadcrumb.Item><Breadcrumb.Page>{domain.name}</Breadcrumb.Page></Breadcrumb.Item>
    </Breadcrumb.List>
  </Breadcrumb.Root>
  <header class="mb-10 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
      {questions.length} curated questions
    </p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{domain.name}</h1>
    <p class="mt-4 text-base leading-8 text-muted-foreground">{domain.description}</p>
  </header>
  <ol
    class="space-y-3"
    data-keyboard-navigation="primary"
    aria-label={`Numbered questions in ${domain.name}`}
  >
    {
      ordered.map((question, index) => (
        <li>
          <a
            href={question.url}
            data-card-navigation
            class="block rounded-2xl no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
          >
            <Card.Root
              size="sm"
              class="rounded-2xl border border-border transition-colors hover:ring-ring/50"
            >
              <Card.Content class="flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex min-w-0 gap-4">
                  <span class="pt-1 text-xs tabular-nums text-muted-foreground">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <h2 class="font-semibold tracking-tight">{question.title}</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">
                      {question.summary}
                    </p>
                    <span
                      data-question-progress={question.id}
                      data-progress-loading
                      aria-hidden="true"
                      class="progress-indicator progress-indicator--question mt-3 inline-flex min-h-6 w-fit items-center rounded-full border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground"
                    />
                  </div>
                </div>
                <Badge.Badge variant="outline" class="shrink-0 capitalize">
                  {question.difficulty} · {question.minutes} min
                </Badge.Badge>
              </Card.Content>
            </Card.Root>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
