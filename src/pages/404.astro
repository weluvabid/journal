---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Button } from '@weluvabid/iris/components';
import { withBase } from '@lib/journal';
---

<BaseLayout
  title="Page not found — Journal"
  description="The page you're looking for doesn't exist."
>
  <section class="mx-auto max-w-2xl py-16 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">This page wandered off.</h1>
    <p class="mt-4 text-base leading-8 text-muted-foreground">
      The page may have moved, or the address may be incorrect.
    </p>
    <div class="mt-7 flex justify-center gap-3">
      <Button.Root href={withBase('/')} variant="default">Go home</Button.Root><Button.Root
        href={withBase('/journal/')}
        variant="outline">Browse Journal</Button.Root
      >
    </div>
  </section>
</BaseLayout>
