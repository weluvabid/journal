---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CategorySelect from '@components/journal/CategorySelect.svelte';
import JournalEntryList from '@components/journal/JournalEntryList.svelte';
import { categories } from '@data/categories';
import { entryHref, withBase } from '@lib/journal';
import { tagHref } from '@lib/journal-tags';
import { JOURNAL_PAGE_SIZE, paginateItems } from '@lib/journal-pagination';

const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (left, right) =>
    right.data.date.valueOf() - left.data.date.valueOf() ||
    left.data.id.localeCompare(right.data.id),
);
const { items: firstPage, nextPage } = paginateItems(entries, 1);
const initialEntries = firstPage.map((entry) => ({
  id: entry.data.id,
  title: entry.data.title,
  summary: entry.data.summary,
  type: entry.data.type,
  date: entry.data.date.toISOString(),
  dateLabel: entry.data.date.toLocaleDateString('en', { dateStyle: 'medium', timeZone: 'UTC' }),
  tags: entry.data.tags,
  href: entryHref(entry.data.id),
}));
const nextPageUrl = nextPage === null ? null : withBase(`/journal/data/all/${nextPage}.json`);
---
<BaseLayout title="Journal — Writing and engineering notes" description="Engineering notes, build logs, deep dives and retrospectives.">
  <header class="mb-10 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">The journal</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Writing & notes</h1>
    <p class="mt-4 text-base leading-8 text-muted-foreground">An evolving record of experiments, implementation decisions, technical explorations and lessons from building software.</p>
  </header>
  <div class="mb-6 max-w-xs">
    <CategorySelect client:load categories={categories} base={import.meta.env.BASE_URL} />
  </div>
  <p class="mb-5 text-xs text-muted-foreground">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
  <JournalEntryList
    client:load
    initialEntries={initialEntries}
    nextPageUrl={nextPageUrl}
    ariaLabel="Journal entries"
  />
  <noscript>
    <ol class="mt-3 space-y-3" aria-label="Remaining journal entries">
      {entries.slice(JOURNAL_PAGE_SIZE).map((entry, index) => (
        <li>
          <article class="rounded-2xl border border-border p-4">
              <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 gap-4">
                  <span class="pt-1 text-xs tabular-nums text-muted-foreground">{String(index + JOURNAL_PAGE_SIZE + 1).padStart(2, '0')}</span>
                  <div class="min-w-0">
                    <h2 class="font-semibold tracking-tight"><a href={entryHref(entry.data.id)} class="no-underline hover:underline">{entry.data.title}</a></h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">{entry.data.summary}</p>
                    <nav class="mt-3 flex max-w-full flex-nowrap gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible sm:pb-0" aria-label={`Tags for ${entry.data.title}`}>{entry.data.tags.map((tag) => <a href={tagHref(tag)} class="shrink-0 rounded-full border border-border px-2.5 py-1 text-xs no-underline">{tag}</a>)}</nav>
                  </div>
                </div>
                <time class="shrink-0 text-xs text-muted-foreground">{entry.data.date.toLocaleDateString('en', { dateStyle: 'medium', timeZone: 'UTC' })}</time>
              </div>
          </article>
        </li>
      ))}
    </ol>
  </noscript>
</BaseLayout>
