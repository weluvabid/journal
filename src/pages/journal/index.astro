---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Card, Badge } from '@weluvabid/iris/components';
import { withBase, entryHref } from '@lib/journal';
const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const visible = entries;
---
<BaseLayout title="Journal — Writing and engineering notes" description="Engineering notes, build logs, deep dives and retrospectives.">
  <header class="mb-10 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">The journal</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Writing & notes</h1>
    <p class="mt-4 text-base leading-8 text-muted-foreground">An evolving record of experiments, implementation decisions, technical explorations and lessons from building software.</p>
  </header>
  <div class="mb-6 flex flex-wrap gap-2">
    <a class="rounded-full border border-border px-3 py-1.5 text-sm no-underline hover:bg-muted" href={withBase('/journal/')}>All entries</a>
    {['systems-engineering','frontend-engineering','product-engineering','engineering-thinking'].map((id) => <a class="rounded-full border border-border px-3 py-1.5 text-sm no-underline hover:bg-muted" href={withBase(`/journal/category/${id}/`)}>{id.replaceAll('-', ' ')}</a>)}
  </div>
  <p class="mb-5 text-xs text-muted-foreground">{visible.length} {visible.length === 1 ? 'entry' : 'entries'}</p>
  <ol class="space-y-3" data-keyboard-navigation="primary" aria-label="Journal entries">
    {visible.map((entry, index) => <li><a href={entryHref(entry.data.id)} data-card-navigation class="block rounded-2xl no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">
      <Card.Root size="sm" class="rounded-2xl border border-border transition-colors hover:ring-ring/50"><Card.Content class="flex flex-col gap-3 p-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex min-w-0 gap-4"><span class="pt-1 text-xs tabular-nums text-muted-foreground">{String(index+1).padStart(2,'0')}</span><div class="min-w-0"><h2 class="font-semibold tracking-tight">{entry.data.title}</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">{entry.data.summary}</p><div class="mt-3 flex flex-wrap gap-2">{entry.data.tags.map((tag) => <Badge.Badge variant="outline">{tag}</Badge.Badge>)}</div></div></div>
        <div class="flex shrink-0 items-center gap-2 text-xs text-muted-foreground"><span>{entry.data.date.toLocaleDateString('en', { dateStyle: 'medium' })}</span><span aria-hidden="true">·</span><span class="capitalize">{entry.data.type.replaceAll('-', ' ')}</span></div>
      </Card.Content></Card.Root>
    </a></li>)}
  </ol>
</BaseLayout>
