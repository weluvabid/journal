---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Breadcrumb } from '@weluvabid/iris/components';
import CategorySelect from '@components/journal/CategorySelect.svelte';
import JournalEntryList from '@components/journal/JournalEntryList.svelte';
import JournalEntryCard from '@components/cards/JournalEntryCard.svelte';
import { categories } from '@data/categories';
import { entryHref, withBase } from '@lib/journal';
import { serializeJournalEntries } from '@lib/journal-list/serialize-entry';
import { JOURNAL_PAGE_SIZE, paginateItems } from '@lib/journal-pagination';
import {
  getJournalSeriesPartCount,
  sortJournalEntriesWithSeriesGroups,
} from '@lib/journal-series-navigation';
import { INTENTS, pluralize } from '@lib/content-text';

const entries = sortJournalEntriesWithSeriesGroups(
  await getCollection('journal', ({ data }) => !data.draft),
);
const { items: firstPage, nextPage } = paginateItems(entries, 1);
const initialEntries = serializeJournalEntries(
  firstPage,
  (entry) => entryHref(entry.data.id, 'all'),
  (seriesId) => getJournalSeriesPartCount(entries, seriesId),
);
const serializedEntries = serializeJournalEntries(
  entries,
  (entry) => entryHref(entry.data.id, 'all'),
  (seriesId) => getJournalSeriesPartCount(entries, seriesId),
);
const nextPageUrl = nextPage === null ? null : withBase(`/journal/data/all/${nextPage}.json`);
---

<BaseLayout
  title="Journal — Writing and engineering notes"
  description="Engineering notes, build logs, deep dives and retrospectives."
>
  <Breadcrumb.Root class="mb-8"
    ><Breadcrumb.List
      ><Breadcrumb.Item><Breadcrumb.Page>Journal</Breadcrumb.Page></Breadcrumb.Item
      ></Breadcrumb.List
    ></Breadcrumb.Root
  >
  <h1 class="sr-only">Journal</h1>
  <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
    {pluralize(entries.length, INTENTS.entry)}
  </p>
  <div class="mb-6 min-w-0 max-w-full">
    <CategorySelect client:load categories={categories} base={import.meta.env.BASE_URL} />
  </div>
  <JournalEntryList
    client:load
    initialEntries={initialEntries}
    nextPageUrl={nextPageUrl}
    ariaLabel="Journal entries"
  />
  <noscript>
    <ol class="mt-3 space-y-3" aria-label={'Remaining journal entries'}>
      {
        entries.slice(JOURNAL_PAGE_SIZE).map((entry, index) => (
          <li>
            <JournalEntryCard
              entry={serializedEntries[index + JOURNAL_PAGE_SIZE]}
              index={index + JOURNAL_PAGE_SIZE}
            />
          </li>
        ))
      }
    </ol>
  </noscript>
</BaseLayout>
