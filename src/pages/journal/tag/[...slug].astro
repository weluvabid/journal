---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Breadcrumb } from '@weluvabid/iris/components';
import JournalEntryList from '@components/journal/JournalEntryList.svelte';
import JournalEntryCard from '@components/cards/JournalEntryCard.svelte';
import { entryHref, withBase } from '@lib/journal';
import { groupEntriesByTag } from '@lib/journal-tags';
import { JOURNAL_PAGE_SIZE, paginateItems } from '@lib/journal-pagination';
import { INTENTS, pluralize } from '@lib/content-text';
import { getJournalSeriesPartCount } from '@lib/journal-series-navigation';

export async function getStaticPaths() {
  const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
    (left, right) =>
      right.data.date.valueOf() - left.data.date.valueOf() ||
      left.data.id.localeCompare(right.data.id),
  );

  return [...groupEntriesByTag(entries).entries()].map(([slug, group]) => ({
    params: { slug },
    props: { slug, label: group.label, entries: group.entries },
  }));
}

const { slug, label, entries } = Astro.props;
const allJournalEntries = await getCollection('journal', ({ data }) => !data.draft);
const { items: firstPage, nextPage } = paginateItems(entries, 1);
const initialEntries = firstPage.map((entry) => ({
  id: entry.data.id,
  title: entry.data.title,
  summary: entry.data.summary,
  type: entry.data.type,
  date: entry.data.date.toISOString(),
  dateLabel: entry.data.date.toLocaleDateString('en', { dateStyle: 'medium', timeZone: 'UTC' }),
  tags: entry.data.tags,
  ...(entry.data.series
    ? {
        series: {
          part: entry.data.series.part,
          totalParts: getJournalSeriesPartCount(allJournalEntries, entry.data.series.id),
        },
      }
    : {}),
  href: entryHref(entry.data.id),
}));
const nextPageUrl =
  nextPage === null ? null : withBase(`/journal/data/tag/${slug}/${nextPage}.json`);
---

<BaseLayout title={`Tagged “${label}” — Journal`} description={`Journal entries tagged ${label}.`}>
  <Breadcrumb.Root class="mb-8"
    ><Breadcrumb.List
      ><Breadcrumb.Item
        ><Breadcrumb.Link href={withBase('/journal/')}>Journal</Breadcrumb.Link></Breadcrumb.Item
      ><Breadcrumb.Separator /><Breadcrumb.Item
        ><Breadcrumb.Page>#{label}</Breadcrumb.Page></Breadcrumb.Item
      ></Breadcrumb.List
    ></Breadcrumb.Root
  >
  <p class="mb-10 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
    {pluralize(entries.length, INTENTS.entry)}
  </p>
  <JournalEntryList
    client:load
    initialEntries={initialEntries}
    nextPageUrl={nextPageUrl}
    ariaLabel={`Journal entries tagged ${label}`}
  />
  <noscript>
    <ol class="mt-3 space-y-3" aria-label={`Entries tagged ${label}`}>
      {
        entries.slice(JOURNAL_PAGE_SIZE).map((entry, index) => (
          <li>
            <JournalEntryCard
              entry={{
                id: entry.data.id,
                title: entry.data.title,
                summary: entry.data.summary,
                type: entry.data.type,
                date: entry.data.date.toISOString(),
                dateLabel: entry.data.date.toLocaleDateString('en', {
                  dateStyle: 'medium',
                  timeZone: 'UTC',
                }),
                tags: entry.data.tags,
                ...(entry.data.series
                  ? {
                      series: {
                        part: entry.data.series.part,
                        totalParts: getJournalSeriesPartCount(allJournalEntries, entry.data.series.id),
                      },
                    }
                  : {}),
                href: entryHref(entry.data.id),
              }}
              index={index + JOURNAL_PAGE_SIZE}
            />
          </li>
        ))
      }
    </ol>
  </noscript>
</BaseLayout>
