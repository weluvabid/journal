---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Breadcrumb } from '@weluvabid/iris/components';
import CategorySelect from '@components/journal/CategorySelect.svelte';
import JournalEntryList from '@components/journal/JournalEntryList.svelte';
import JournalEntryCard from '@components/cards/JournalEntryCard.svelte';
import { categories, categoryById } from '@data/categories';
import { entryHref, withBase } from '@lib/journal';
import { JOURNAL_PAGE_SIZE, paginateItems } from '@lib/journal-pagination';

export async function getStaticPaths() {
  return [...categoryById.values()].map((category) => ({
    params: { slug: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const entries = (
  await getCollection('journal', ({ data }) => !data.draft && data.category === category.id)
).sort(
  (left, right) =>
    right.data.date.valueOf() - left.data.date.valueOf() ||
    left.data.id.localeCompare(right.data.id),
);
const { items: firstPage, nextPage } = paginateItems(entries, 1);
const initialEntries = firstPage.map((entry) => ({
  id: entry.data.id,
  title: entry.data.title,
  summary: entry.data.summary,
  type: entry.data.type,
  date: entry.data.date.toISOString(),
  dateLabel: entry.data.date.toLocaleDateString('en', { dateStyle: 'medium', timeZone: 'UTC' }),
  tags: entry.data.tags,
  href: entryHref(entry.data.id),
}));
const nextPageUrl =
  nextPage === null ? null : withBase(`/journal/data/category/${category.id}/${nextPage}.json`);
---

<BaseLayout title={`${category.name} — Journal`} description={category.description}>
  <Breadcrumb.Root class="mb-8"
    ><Breadcrumb.List
      ><Breadcrumb.Item
        ><Breadcrumb.Link href={withBase('/journal/')}>Journal</Breadcrumb.Link></Breadcrumb.Item
      ><Breadcrumb.Separator /><Breadcrumb.Item
        ><Breadcrumb.Page>{category.name}</Breadcrumb.Page></Breadcrumb.Item
      ></Breadcrumb.List
    ></Breadcrumb.Root
  >
  <h1 class="sr-only">{category.name}</h1>
  <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
    {entries.length}
    {entries.length === 1 ? 'entry' : 'entries'}
  </p>
  <div class="mb-6 min-w-0 max-w-full">
    <CategorySelect
      client:load
      categories={categories}
      current={category.id}
      base={import.meta.env.BASE_URL}
    />
  </div>
  <JournalEntryList
    client:load
    initialEntries={initialEntries}
    nextPageUrl={nextPageUrl}
    ariaLabel={`Entries in ${category.name}`}
  />
  <noscript>
    <ol class="mt-3 space-y-3" aria-label={`Entries in ${category.name}`}>
      {
        entries.slice(JOURNAL_PAGE_SIZE).map((entry, index) => (
          <li>
            <JournalEntryCard
              entry={{
                id: entry.data.id,
                title: entry.data.title,
                summary: entry.data.summary,
                type: entry.data.type,
                date: entry.data.date.toISOString(),
                dateLabel: entry.data.date.toLocaleDateString('en', {
                  dateStyle: 'medium',
                  timeZone: 'UTC',
                }),
                tags: entry.data.tags,
                href: entryHref(entry.data.id),
              }}
              index={index + JOURNAL_PAGE_SIZE}
            />
          </li>
        ))
      }
    </ol>
  </noscript>
</BaseLayout>
